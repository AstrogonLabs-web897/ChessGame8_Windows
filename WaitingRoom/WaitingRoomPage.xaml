<Page x:Class="ChessGame8.WaitingRoom.WaitingRoomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ChessGame8.WaitingRoom"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Waiting Room">
    <Grid>
        <Canvas Name="WaitingRommCanvas" Background="LightGoldenrodYellow"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Ожидание соперника..." FontSize="24" FontWeight="Bold" Margin="0,20,0,20"/>
            <ProgressBar x:Name="myProgressBar" Minimum="0" Maximum="100" Value="0" Height="20" Margin="0,20,0,20"/>
            <Button Content="Покинуть зал ожидания" Width="150" Height="40" Margin="0,20,0,0" Click="ExitWaitingRoom_Click"/>
        </StackPanel>
    </Grid>
</Page>
