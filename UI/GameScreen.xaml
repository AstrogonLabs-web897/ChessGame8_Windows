<Page x:Class="ChessGame8.UI.GameScreen"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ChessGame8.UI"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Однопользовательская игра">
    <Grid>
        <Canvas Name="GameScreenCanvas" Background="LightGoldenrodYellow"></Canvas>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Игрок против компьютера" FontSize="24" FontWeight="Bold" Margin="0,20,0,20"/>
            <TextBlock Text="Готовьтесь к началу игры" FontSize="24" FontWeight="Bold" Margin="0,20,0,20"/>
            <ProgressBar x:Name="myProgressBar" Minimum="0" Maximum="100" Value="0" Width="300" Height="30" Margin="0,20,0,0"/>
            <Button Content="Вернуться в главное меню" Width="150" Height="40" Margin="0,20,0,0" Click="ReturnMainWindow_Click"/>
        </StackPanel>
    </Grid>
</Page>
