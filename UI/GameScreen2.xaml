        <Canvas x:Name="ChessCanvas" Background="LightGoldenrodYellow"/>
        <!-- Добавляем UserControl -->
        <local:GameScreen3 x:Name="GameScreenControl" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"/>
    </Grid>
</Page>
