<Window x:Class="ChessGame8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessGame8"
        mc:Ignorable="d"
        d:DesignHeight="600" d:DesignWidth="800"
        Title="Chess Game"  Background="LightGoldenrodYellow">
    <Grid>
        <Canvas Name="ChessGame" Background="LightGoldenrodYellow"/>
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Margin="1"/>
        <!--<Button x:Name="SettingsButton" Content="☰" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Click="SettingsButton_Click"/> -->
        <Grid DockPanel.Dock="Top">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Нажмите на кнопку, чтобы начать игру" FontSize="18" FontWeight="Bold" Margin="0,20,0,20"/>
                <Button Content="Начать игру" Width="150" Height="40" Margin="0,20,0,0" Click="StartGameButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
