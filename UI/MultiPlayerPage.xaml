<Page x:Class="ChessGame8.UI.MultiPlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ChessGame8.UI"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title=" Режим MultiPlayer">

    <Grid>
        <Canvas Name="MultiplayerCanvas" Background="LightGoldenrodYellow"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Кооперативный режим" FontSize="24" FontWeight="Bold" Margin="0,20,0,20"/>
            <TextBlock Text="Количество игроков: " FontSize="16" Margin="0,10,0,0"/>
            <TextBlock x:Name="PlayersCountLabel" FontSize="16" Margin="0,10,0,0"/>
            <TextBlock Text="Текущий игрок: " FontSize="16" Margin="0,10,0,0"/>
            <TextBlock x:Name="CurrentPlayerLabel" FontSize="16" Margin="0,10,0,0"/>
            <Button Content="Назад" Width="150" Height="40" Margin="0,20,0,0" Click="BackButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
