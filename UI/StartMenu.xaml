<Page x:Class="ChessGame8.UI.StartMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ChessGame8.UI"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Welcom to Chess Game">

    <Grid>
        <Canvas Name="StartMenuCanvas" Background="LightGoldenrodYellow"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Welcome to Chess Game" FontSize="24" FontWeight="Bold" Margin="0,20,0,20"/>
            <TextBlock Text="Введите своё имя:" Margin="0,20,0,0"/>
            <TextBox x:Name="PlayerNameInput" Width="200" Height="30" Margin="0,10,0,0" PreviewKeyDown="PlayerNameInput_PreviewKeyDown"  TextChanged="PlayerNameImput_TextChaged" LostFocus="PlayerNameInput_LostFocus"/>
            <Button x:Name="GameOptionsButton" Content="Game Options" Width="150" Height="40" Margin="0,20,0,20" Click="GameOptionsButton_Click"/>
            <Button x:Name="StartGameButton" Content="Start Game" Width="150" Height="40" Margin="0,20,0,20" Click="StartGameButton_Click"/>
            <Button Content="Save Game" Width="150" Height="40" Margin="0,20,2,20" Click="SaveGameButton_Click"/>
            <Button Content="Load Game" Width="150" Height="40" Margin="0,20,0,20" Click="LoadGameButton_Click"/>
            <Button Content="Go Back"  Width="150" Height="40"  Margin="0,20,0,20" Click="GoBackButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
