<Application x:Class="ChessGame8.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ChessGame8" 
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Словарь с постоянной шапкой приложения -->
                <ResourceDictionary Source="/Dictionary1.xaml"/>
                <!-- Темная или светлая тема -->
                <ResourceDictionary Source="res/Thems/WhiteTheme.xaml"/>
                <!-- Или: <ResourceDictionary Source="res/Thems/DarkTheme.xaml"/> -->
            </ResourceDictionary.MergedDictionaries> 
                 <!--Конвертеры-->
            <local:ThemeToIsCheckedConverter x:Key="ThemeToIsCheckedConverter"/>
            <local:SubstaractConverter x:Key="SubstractConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
